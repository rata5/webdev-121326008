# Every environment variable the app reads, with harmless placeholder values.
# For local use: cp .env.example .env, then put real values in .env (git ignores it).
# On Render, set the same names under Environment. Real values never go into git.

# ---- Needed to start. Without them the app stops and names what is missing.
# The PostgreSQL connection string from Neon's Connect dialog, with sslmode=verify-full.
DATABASE_URL=postgresql://neondb_owner:npg_1lpGokc5Pqzi@ep-blue-cloud-bdwq01ti-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Signs the session cookie. Make one with: openssl rand -hex 32
SESSION_SECRET=0b5edd5926a71f9e3d11aafda2882d04fe391b49aac4644bade92811ee76a24f

# ---- Optional, with a default.
# The port the server listens on. Render sets its own; do not add PORT there.
PORT=3000
# "production" marks the session cookie Secure (HTTPS only). Render: production.
NODE_ENV=development
# The address people open, with no trailing slash. Google sign-in builds its redirect URI from it.
PUBLIC_BASE_URL=https://infamous-seance-jjjw76x6qgp2pq97-3000.app.github.dev

# ---- Sign in with Google (step 8). Without both, the Google button says it is not set up.
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- The model feature. Without a key, "Find me a slot" shows its fallback slots.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# ---- The MCP server only (npm run mcp). It runs in your codespace, not on Render.
# The value of your lb_session cookie, the part before the dot.
MCP_TOKEN=